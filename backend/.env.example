# Database
DATABASE_URL=postgresql+psycopg://financeuser:financepass@localhost:5433/finance_db
# Production example:
# DATABASE_URL=postgresql+psycopg://financeuser:financepass@db:5432/finance_db?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend / CORS
APP_URL=http://localhost:8080
# Optional explicit overrides (defaults derive from APP_URL in app code)
# FRONTEND_URL=http://localhost:8080
# CORS_ALLOW_ORIGINS=http://localhost:8080

# Optional toggles
API_DOCS_ENABLED=false
AUTO_CREATE_TABLES=false

# Logging
# Level: debug | info | warn | error. Can also be changed at runtime from
# Settings > Authentication (admin) in the frontend, without a restart —
# that writes to the database and every gunicorn worker picks it up within
# ~10s. This env var is only the fallback used when no database override
# is set.
LOG_LEVEL=info
# Format: text (human-readable, default) or json (structured; recommended
# when logs are shipped to an aggregator).
LOG_FORMAT=text

# Optional OpenAI-compatible LLM integration
# Use LLM_BASE_URL for Ollama, vLLM, LM Studio, LocalAI, or another compatible API.
# The legacy OPENAI_API_KEY and OPENAI_BASE_URL variables remain supported.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional fallback LLM provider. Used automatically when the primary
# provider above (or the key saved in Settings) returns a quota/auth/rate
# limit error, e.g. a local Ollama/vLLM server as a free backstop when a
# paid OpenAI key runs out of credit. Leave LLM_FALLBACK_BASE_URL empty to
# disable — this is deployment-only, there is no per-user setting for it.
# LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
# LLM_FALLBACK_API_KEY=local-llm
# LLM_FALLBACK_MODEL=qwen3:8b

# Receipt scanning extraction engine: "vision" (a single vision-model call
# under a strict JSON schema, per docs/specs/receipt-ingestion.md Part 1) or
# "tesseract" (the legacy OCR + regex pass). Defaults to "tesseract" for this
# release -- this is the rollback lever if the vision path misbehaves in
# production; flip it back to "tesseract" without a deploy.
RECEIPT_EXTRACTION_ENGINE=tesseract

# Receipt resolve policy (Phase 6, docs/specs/receipt-ingestion-implementation.md
# 6.1): the merchant/threshold collapse that folds small non-grocery treats
# on a grocery receipt into one grocery transaction. Each also has a
# database override (app_settings) that wins over these; unset/empty
# disables the collapse. RECEIPT_GROCERY_MERCHANTS is comma-separated and
# matched case-insensitively against the receipt's merchant name.
# RECEIPT_GROCERY_MERCHANTS=Rimi,Maxima,Lidl
# RECEIPT_GROCERY_CATEGORY_ID=
# RECEIPT_TREAT_SPLIT_THRESHOLD=5.00
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# Enable Banking (Open Banking / PSD2)
# Sandbox vs production is determined by the app credentials, not a separate flag.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# OR use a file path instead:
# ENABLE_BANKING_PRIVATE_KEY_PATH=/path/to/private-key.pem
ENABLE_BANKING_REDIRECT_URI=http://localhost:8080/api/enable-banking/callback

# Demo environment controls
# Enable only in dedicated demo deployments.
DEMO_MODE=false
# Shared demo account identity (provide one or both)
DEMO_SHARED_USER_EMAIL=
DEMO_SHARED_USER_ID=
# Nightly reset controls (UTC)
DEMO_RESET_ENABLED=false
DEMO_RESET_HOUR_UTC=0
# Daily transaction engine controls (adds previous-day demo transactions)
DEMO_DAILY_ENGINE_ENABLED=false
DEMO_DAILY_ENGINE_HOUR_UTC=2
DEMO_DAILY_ENGINE_MINUTE_UTC=15
# Deterministic random seed for demo data generation
DEMO_SEED_RANDOM_SEED=42

# Optional application-layer encryption (recommended for production).
# Use a 32-byte key encoded as base64 or hex.
# DATA_ENCRYPTION_KEY_CURRENT=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# DATA_ENCRYPTION_KEY_ID=k1


# Internal app <-> backend auth (required)
# Shared secret with the frontend; HMAC-signs /internal/* and /api/* calls.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=
# Frontend base URL used for backend-initiated callbacks/links.
FRONTEND_URL=http://localhost:3000
